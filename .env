# learn-anything-sandbox — committed env defaults (no secrets).
# `next dev` reads PORT from the environment; this file sets it so the
# sandbox dev server never collides with the main app's 3000.
# Local override: `.env.local` (gitignored) wins over this file.
PORT=3001

# Origins allowed to embed this app in an <iframe> (CSP frame-ancestors,
# sent by next.config.ts on every response). Comma-separated full origins
# with scheme. 'self' is always allowed; an empty value fails secure to
# 'self' only.
ALLOWED_FRAME_ANCESTORS=http://localhost:3000

# Base URL of the backend that serves slide demos (issue #1). The
# `/slides/{slide_id}/bundle.js` route fetches `${NEXT_PUBLIC_BACKEND_URL}/slides/{slide_id}`
# (JSON `{ slide_id, content }`, `content` is TSX) and compiles it per request.
# Read server-side in app/slides/[...slides]/route.ts. Default is the local
# backend; override via the gitignored `.env.local`.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# SANDBOX_SERVICE_TOKEN — service-identity secret for the Sandbox -> backend
# slides fetch (#102/#104). Fail-secure: the route 500s without it, and the
# backend rejects the fetch without a matching header. It must live in the
# gitignored `.env.local` (never in this file — no secrets here) and match the
# backend's own SANDBOX_SERVICE_TOKEN.
