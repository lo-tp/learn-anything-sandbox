# learn-anything-sandbox — committed env defaults (no secrets).
# `next dev` reads PORT from the environment; this file sets it so the
# sandbox dev server never collides with the main app's 3000.
# Local override: `.env.local` (gitignored) wins over this file.
PORT=3001

# Origins allowed to embed this app in an <iframe> (CSP frame-ancestors,
# sent by next.config.ts on every response). Comma-separated full origins
# with scheme. 'self' is always allowed; an empty value fails secure to
# 'self' only.
ALLOWED_FRAME_ANCESTORS=http://localhost:3000
