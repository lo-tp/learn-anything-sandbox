{
  "name": "learn-anything",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "build:katex": "node scripts/build-katex-commands.mjs",
    "build:vendor": "npm run build:katex && node scripts/build-sandbox.mjs",
    "pretest": "npm run build:vendor",
    "predev": "npm run build:vendor",
    "prebuild": "npm run build:vendor"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "katex": "^0.18.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-katex": "^3.1.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
